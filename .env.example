# ZFile MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: ZFile server URL
ZFILE_URL=https://your-zfile-server.com

# Required: ZFile admin credentials
ZFILE_USER=admin
ZFILE_PASS=your_password

# Optional: Storage source key (default: 1)
ZFILE_STORAGE_KEY=1

# Optional: Custom access token (auto-generated if not set)
# ACCESS_TOKEN=your-custom-token

# Optional: Chunk size in MB for large file upload (default: 10)
# CHUNK_SIZE_MB=10

# Optional: External URL for chunked upload commands (auto-detected if not set)
# Useful when behind reverse proxies where auto-detection may not work correctly
# MCP_SERVER_URL=https://your-server.com

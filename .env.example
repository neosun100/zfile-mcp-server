# ZFile MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: ZFile server URL
ZFILE_URL=https://your-zfile-server.com

# Required: ZFile admin credentials
ZFILE_USER=admin
ZFILE_PASS=your_password

# Optional: Storage source key (default: 1)
ZFILE_STORAGE_KEY=1

# Optional: Custom access token (auto-generated if not set)
# ACCESS_TOKEN=your-custom-token
